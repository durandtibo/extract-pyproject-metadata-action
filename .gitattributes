# Ship only what the action needs at runtime (action.yaml, LICENSE, scripts/run.sh,
# scripts/extract_metadata.py and the package src/extract_pyproject_metadata/). Everything else
# is excluded from `git archive`. When the action starts using a new file, un-ignore it here
# and add it to dev/check_export.sh.
/.github/ export-ignore
/.make/ export-ignore
/dev/ export-ignore
/review/ export-ignore
/test-data/ export-ignore
/tests/ export-ignore
/scripts/compare_json.py export-ignore
/scripts/generate_docs.py export-ignore
/scripts/test-helper.sh export-ignore
/scripts/vendor_packaging.py export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.markdownlint.json export-ignore
/.pre-commit-config.yaml export-ignore
/.yamllint.yaml export-ignore
/CLAUDE.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
/CONTRIBUTING.md export-ignore
/Makefile export-ignore
/README.md export-ignore
/SECURITY.md export-ignore
/pyproject.toml export-ignore
/uv.lock export-ignore
